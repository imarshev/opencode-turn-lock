{
  "name": "opencode-turn-lock",
  "version": "0.2.0",
  "description": "OpenCode V2 plugin that keeps at most N local agent sessions on the model engine, queues the rest per turn in three priority levels (⚡ high, ordinary, ▽ low), and marks a waiting session with a ⏳ title prefix. Ships a Tampermonkey/Violentmonkey userscript that adds the /prio queue pill to the web UI.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/*.test.ts\"",
    "build": "vite build",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.5",
    "@types/node": "^24.19.2",
    "solid-js": "^1.9.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.15"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "local-llm",
    "llm",
    "scheduler",
    "queue",
    "conversation-cache"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode/plugin": "*"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  }
}
